# ════════════════════════════════════
#  3xtremes — Environment Variables
# ════════════════════════════════════

# Deployer private key (no 0x prefix)
PRIVATE_KEY=your_private_key_here

# Arc Testnet RPC
ARC_RPC_URL=https://rpc.arc-testnet.io

# USDC contract address on Arc testnet
USDC_ADDRESS=0x...

# Gelato VRF operator address (from Gelato dashboard)
GELATO_OPERATOR_ADDRESS=0x...

# Gelato Automation address (set after creating automation task)
GELATO_KEEPER_ADDRESS=0x...

# ─── Deployed Contract Addresses (fill after deploy) ───
FEE_MANAGER_ADDRESS=0x...
CREDIT_VAULT_ADDRESS=0x...
VRF_CONSUMER_ADDRESS=0x...
ROUND_ENGINE_ADDRESS=0x...
POSITION_MANAGER_ADDRESS=0x...

# ─── Bot Config ────────────────────────────────────────
# WebSocket URL for price broadcasting
WS_PORT=8080

# How often liquidation bot checks (ms)
LIQUIDATION_CHECK_INTERVAL=1000

# ─── Frontend ──────────────────────────────────────────
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.arc-testnet.io
NEXT_PUBLIC_FEE_MANAGER_ADDRESS=0x...
NEXT_PUBLIC_CREDIT_VAULT_ADDRESS=0x...
NEXT_PUBLIC_VRF_CONSUMER_ADDRESS=0x...
NEXT_PUBLIC_ROUND_ENGINE_ADDRESS=0x...
NEXT_PUBLIC_POSITION_MANAGER_ADDRESS=0x...
NEXT_PUBLIC_WS_URL=ws://localhost:8080
